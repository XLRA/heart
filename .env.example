# Spotify API Configuration
# Get your Client ID + Secret from https://developer.spotify.com/dashboard
# Make sure to add your redirect URI to the app's allow-list in the dashboard.

# Public (exposed to browser)
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://localhost:3000/music/callback

# Server-only
SPOTIFY_CLIENT_SECRET=
